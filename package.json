{
  "name": "vickey-racing-game",
  "version": "1.0.0",
  "description": "Vickey - simple racing game for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.vickey.racinggame",
    "productName": "Vickey",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!dist",
      "!README.md",
      "!node_modules"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}
